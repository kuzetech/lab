CORE_CONF_fs_defaultFS=hdfs://namenode:9000

HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_permissions_enabled=false

YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_resourcemanager_address=resourcemanager:8032
YARN_CONF_yarn_resourcemanager_scheduler_address=resourcemanager:8030
YARN_CONF_yarn_resourcemanager_resource__tracker_address=resourcemanager:8031
YARN_CONF_yarn_resourcemanager_admin_address=resourcemanager:8033
YARN_CONF_yarn_resourcemanager_webapp_address=resourcemanager:8088

YARN_CONF_yarn_nodemanager_aux__services=mapreduce_shuffle
# Persist completed application logs in HDFS so `yarn logs -applicationId ...`
# remains available after a NodeManager container cleans its local log files.
YARN_CONF_yarn_log___aggregation___enable=true
YARN_CONF_yarn_nodemanager_remote___app___log___dir=/tmp/logs
YARN_CONF_yarn_nodemanager_resource_memory___mb=3072
YARN_CONF_yarn_scheduler_maximum___allocation___mb=3072
YARN_CONF_yarn_scheduler_minimum___allocation___mb=128
YARN_CONF_yarn_nodemanager_resource_cpu___vcores=4
YARN_CONF_yarn_scheduler_maximum___allocation___vcores=4
# Allow the 512 MiB YARN session AM and a 768 MiB Flink application AM to run
# together. Hadoop's default is 10%, which is only 384 MiB on this cluster.
YARN_CONF_yarn_scheduler_capacity_maximum___am___resource___percent=0.5
